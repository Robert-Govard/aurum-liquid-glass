# Copy this file to .env and adjust values before running `docker compose up`.

# --- Postgres ---
AURUM_POSTGRES_USER=aurum
AURUM_POSTGRES_PASSWORD=change-me
AURUM_POSTGRES_DB=aurum
AURUM_POSTGRES_HOST=db
AURUM_POSTGRES_PORT=5432

# --- Backend ---
# Comma-separated list of browser origins allowed to call the API. Leave it
# empty unless you serve the frontend from a different origin than the API:
# docker compose serves both from the same nginx, and the Vite dev server
# proxies /api, so neither needs this. "*" is honoured but then credentials
# are never granted, because "*" plus credentials lets any site you visit
# read this instance.
AURUM_CORS_ORIGINS=
AURUM_DEFAULT_CURRENCY=USD

# --- Crypto tab (live prices via CoinGecko) ---
# Free Demo API key, no card required: coingecko.com/en/api/pricing. Leave
# blank and the Crypto tab's price sync just 400s with a message telling
# you to set this — nothing else in the app is affected.
AURUM_COINGECKO_API_KEY=

# --- Auth ---
# Signing key for login sessions. Generate a real one with:
#   openssl rand -hex 32
# Leaving the placeholder means anyone who can read this file could forge
# a valid session for any account.
AURUM_JWT_SECRET=change-me-in-production

# --- Email verification (optional but required for registration to be usable) ---
# Leave AURUM_SMTP_HOST empty and new accounts are created but never
# receive a verification link — since verification is mandatory to log
# in, nobody can actually finish registering until this is set up.
AURUM_SMTP_HOST=
AURUM_SMTP_PORT=587
AURUM_SMTP_USER=
AURUM_SMTP_PASSWORD=
AURUM_SMTP_FROM=
AURUM_SMTP_USE_TLS=true
# Public address this instance is reachable at — used to build the link
# inside the verification email (e.g. https://robertaurum.mooo.com:8443).
AURUM_PUBLIC_URL=

# --- Ports exposed on your host machine ---
AURUM_WEB_PORT=3000
