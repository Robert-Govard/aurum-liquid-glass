# Without this file, `docker build` sends the whole frontend/ directory
# (including node_modules, which can be 100+MB of host-platform-specific
# native binaries) to the daemon, and the final `COPY . .` in the Dockerfile
# copies it straight over the fresh, correct-platform `npm install` output
# from the layer before it. Keep this in sync with .gitignore's intent even
# though the two files serve different tools.
node_modules
dist
.vite
.git
.env
.env.*
!.env.example
.DS_Store
# Native Android project (~1.5MB) and source PNG assets (~400KB) — only
# needed for `npx cap sync`/Android builds, never for the web Docker image.
android
assets
